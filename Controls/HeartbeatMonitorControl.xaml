<UserControl x:Class="MedicalCenter.Controls.HeartbeatMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="36"
             d:DesignWidth="112"
             MaxHeight="38"
             ToolTip="{DynamicResource HealthMonitorTip}">
    <Border CornerRadius="8"
            Padding="6,4"
            Margin="0"
            Background="{DynamicResource BgCardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="6"
                              ShadowDepth="1"
                              Opacity="0.28"
                              Color="Black"/>
        </Border.Effect>
        <Grid Width="98" Height="22">
            <Polyline x:Name="EcLine"
                      Points="2,14 10,14 16,14 20,6 26,20 34,12 44,12 50,4 56,18 68,14 80,14 86,8 92,14"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      VerticalAlignment="Center"
                      StrokeDashArray="3 3"/>
            <Ellipse x:Name="PulseDot"
                     Width="6"
                     Height="6"
                     Fill="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,1,4,0"
                     Opacity="0.95"
                     MouseLeftButtonUp="PulseDot_MouseLeftButtonUp">
                <Ellipse.RenderTransform>
                    <ScaleTransform CenterX="3" CenterY="3"/>
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      ShadowDepth="0"
                                      Opacity="0.75"
                                      Color="{DynamicResource AccentGlowColor}"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>
    </Border>
</UserControl>
