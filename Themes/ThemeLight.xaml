<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgDarkBrush" Color="#DDE8F4"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="#F7FAFF"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>
    <Color x:Key="AccentGlowColor">#FF2A6FD4</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#2A6FD4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E60C2"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#122744"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E7697"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#BCD0E7"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="PopularBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="GhostHoverBrush" Color="#E8F0FD"/>
    <SolidColorBrush x:Key="AccentStripBrush" Color="#2A6FD4"/>
    <SolidColorBrush x:Key="RatingStarBrush" Color="#D99200"/>
    <SolidColorBrush x:Key="MenuPopupItemForegroundBrush" Color="#122744"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFF7FAFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFF7FAFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF122744"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FFE8F0FD"/>
</ResourceDictionary>
