<Window x:Class="MedicalCenter.Views.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="657" Height="750"
        MinWidth="500" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource ThemedWindowStyle}">
            <Setter Property="Title" Value="Новая услуга"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                    <Setter Property="Title" Value="Редактировать услугу"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                    <Setter Property="Title" Value="Детали услуги"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏥" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="Black"/>
                <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Новая услуга"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Text" Value="Детали услуги"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="Редактировать услугу"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Read-only badge -->
                <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="10"
                        Background="{DynamicResource BgInputBrush}" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Только просмотр" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
            <Grid IsEnabled="{Binding IsNotReadOnly}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ShortName -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Название" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.ShortName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Категория" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding Service.Category}"/>
                </StackPanel>

                <!-- FullName -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Полное название" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.FullName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Specialist -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Специалист" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.Specialist, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Department -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Отделение" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding Service.Department}"/>
                </StackPanel>

                <!-- Price -->
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Цена" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.Price, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Duration -->
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Длительность (мин)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.Duration, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Rating -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <Run Text="Рейтинг"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Service.Rating, StringFormat={}{0:F1}}"/>
                    </TextBlock>
                    <Slider Minimum="0" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="{Binding Service.Rating, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Popular + Discount -->
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                    <CheckBox Content="Популярно" IsChecked="{Binding Service.IsPopular}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="Скидка" IsChecked="{Binding Service.HasDiscount}"/>
                </StackPanel>

                <!-- Discount Percent -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Скидка (%)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Service.HasDiscount}" Padding="8,6"/>
                </StackPanel>

                <!-- Patients Count -->
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Количество пациентов" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.PatientsCount, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Описание" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Service.Description, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             Padding="8,6"/>
                </StackPanel>

                <!-- Time Slots -->
                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Доступное время (через ;)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TimeSlotsText, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap"
                             Padding="8,6"/>
                    <TextBlock Text="Пример: 09:00;10:00;11:00;12:00;13:00;14:00;15:00;16:00;17:00"
                               FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Image Path -->
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Изображения (через ;)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ImgPathBox" Height="32"
                             Text="{Binding ImagePathText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"/>
                    <Border x:Name="DropZone"
                            AllowDrop="True"
                            Drop="DropZone_Drop"
                            DragOver="DropZone_DragOver"
                            DragLeave="DropZone_DragLeave"
                            Height="48" Margin="0,4,0,0"
                            CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource BgDarkBrush}">
                        <TextBlock x:Name="DropHint"
                                   Text="📁 Перетащите изображения сюда"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- Buttons Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="right">
                <Button Content="Отмена"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Height="32" Width="103"/>
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Height="34" Width="111">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>