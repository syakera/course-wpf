<Window x:Class="MedicalCenter.Views.AppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История записей"
        Icon="/Assets/MedCenter.ico"
        Cursor="/Assets/arrow.cur"
        Width="1191" Height="500"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="28" Margin="0,0,12,0"/>
                    <TextBlock Text="История записей" 
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="10,4"/>
                    <ComboBox Width="118"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              Margin="0,0,8,0"/>
                    <ComboBox Width="118"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SortOption}"
                              Margin="0,0,8,0"/>
                    <Button Content="Применить" Command="{Binding ApplyFilterCommand}" Padding="10,4"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="40">
                <Button Content="Ожидает" Command="{Binding SetStatusCommand}" CommandParameter="Ожидает" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="96"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Подтвердить" Command="{Binding SetStatusCommand}" CommandParameter="Подтверждена" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="118"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Завершить" Command="{Binding SetStatusCommand}" CommandParameter="Завершена" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="106"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Удалить" Command="{Binding DeleteAppointmentCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="88"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Отменить мою запись"
                        Command="{Binding CancelAppointmentCommand}"
                        Margin="8,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="186"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPatient}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ComboBox Width="70"
                          ItemsSource="{Binding RatingOptions}"
                          SelectedItem="{Binding SelectedRating}"
                          Margin="0,0,8,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPatient}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <Button Content="Оценить" Command="{Binding RateAppointmentCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="94"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPatient}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Завершена" Command="{Binding SetStatusCommand}" CommandParameter="Завершена" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="112"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoctor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Не явился" Command="{Binding SetStatusCommand}" CommandParameter="Не явился">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="MinWidth" Value="108"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDoctor}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="AppointmentsGrid"
                      Grid.Column="0"
                      Margin="20,20,43,20"
                      ItemsSource="{Binding Appointments}"
                      SelectedItem="{Binding SelectedAppointment}"
                      IsReadOnly="{Binding IsAppointmentsGridReadOnly}"
                      AutoGenerateColumns="False"
                      Background="Transparent"
                      RowBackground="{DynamicResource BgCardBrush}"
                      AlternatingRowBackground="{DynamicResource BgInputBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="120"/>
                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="120"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding PatientPhone}" Width="100"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding Doctor}" Width="120"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0} BYN}" Width="80"/>
                    <DataGridTemplateColumn Header="Статус" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" CornerRadius="4" Padding="6,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF9800"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Подтверждена">
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Завершена">
                                                    <Setter Property="Background" Value="#2196F3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Отменена">
                                                    <Setter Property="Background" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border
                    Margin="873,20,20,20"
                    Padding="12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Grid.ColumnSpan="2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Назначения врача"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Text="Выберите запись, чтобы увидеть назначения."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAppointment}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,8"
                               Text="Для выбранной записи пока нет назначений."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedAppointment}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding AppointmentNotes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox ItemsSource="{Binding AppointmentNotes}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="8"
                                        Background="{DynamicResource BgInputBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NoteType}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Content}"
                                                   Margin="0,4,0,4"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="{Binding DoctorName}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Appointments.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Нет записей" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>