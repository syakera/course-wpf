<Window x:Class="MedicalCenter.Views.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Запись на приём"
        Width="540" Height="720"
        MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TimeSlotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource BgDarkBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding ServiceDisplay}"/>
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DisplayDoctorName}"/>
            </StackPanel>
        </Border>

        <!-- Bottom buttons -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="Подтвердить запись"
                        Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanConfirm}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Doctor picker (when entering by service) -->
                <StackPanel Visibility="{Binding ShowDoctorPicker, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ВЫБЕРИТЕ ВРАЧА"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableDoctors}"
                              SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                              DisplayMemberPath="FullName"
                              Background="{DynamicResource BgCardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,14">
                        <ComboBox.Resources>
                            <Style x:Key="DoctorItemStyle" TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="#FF122744"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFE8F0FD"/>
                                                    <Setter Property="Foreground" Value="#FF122744"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFDDEBFF"/>
                                                    <Setter Property="Foreground" Value="#FF122744"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <StaticResource ResourceKey="DoctorItemStyle"/>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>

                <!-- Service picker (when entering by doctor) -->
                <StackPanel Visibility="{Binding ShowServicePicker, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ВЫБЕРИТЕ УСЛУГУ"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableServices}"
                              SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                              DisplayMemberPath="ShortName"
                              Background="{DynamicResource BgCardBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,14"/>
                </StackPanel>

                <!-- Service summary card -->
                <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayService.FullName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DisplayService.Description}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Длительность (мин)" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding DisplayService.Duration}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Рейтинг" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" Foreground="{DynamicResource RatingStarBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding DisplayService.Rating, StringFormat={}{0:F1}}"
                                               FontSize="14" Margin="2,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Цена (BYN)" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding DisplayService.FinalPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Date -->
                <TextBlock Text="ВЫБЕРИТЕ ДАТУ"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            DisplayDateStart="{Binding TodayDate, Mode=OneWay}"
                            Margin="0,0,0,14"/>

                <!-- Slots -->
                <TextBlock Text="ДОСТУПНОЕ ВРЕМЯ"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding AvailableTimeSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Time}"
                                    Command="{Binding DataContext.SelectTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TimeSlotButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource BgPanelBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Нет доступного времени"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvailableTimes}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Patient data -->
                <TextBlock Text="ВАШИ ДАННЫЕ"
                           FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,18,0,6"/>
                <TextBlock Text="ФИО"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="Телефон"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding PatientPhone, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="Комментарий"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding AdditionalComment, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8" FontSize="12"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="64" VerticalScrollBarVisibility="Auto"
                         ToolTip="Комментарий (опционально)"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
