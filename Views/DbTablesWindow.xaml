<Window x:Class="MedicalCenter.Views.DbTablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таблицы базы данных"
        Width="920" Height="560"
        MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <WrapPanel>
                <Button Content="Услуги" Command="{Binding ShowServicesTableCommand}" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="Записи" Command="{Binding ShowAppointmentsTableCommand}" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="Врачи" Command="{Binding ShowDoctorsTableCommand}" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="Лог триггера" Command="{Binding ShowAuditTableCommand}" Margin="0,0,8,0" Padding="10,4"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="10,4"/>
                <TextBlock Text="{Binding ActiveTableName}" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </WrapPanel>
        </Border>

        <DataGrid ItemsSource="{Binding CurrentTable.DefaultView}"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Margin="12"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}" />
    </DockPanel>
</Window>
