<Window x:Class="MedicalCenter.Views.DoctorManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление врачами"
        Width="1007" Height="752"
        WindowStartupLocation="CenterOwner">
    <DockPanel Background="{DynamicResource BgDarkBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Управление врачами" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Добавление, редактирование, назначение услуг" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+ Новый врач"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding NewDoctorCommand}" Margin="0,0,8,0"/>
                    <Button Content="Обновить"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12" Height="71">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Content="Сохранить"
                        Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                <Button Content="Деактивировать"
                        Background="{DynamicResource WarningBrush}"
                        Foreground="White"
                        Padding="14,6"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DeactivateCommand}"/>
            </StackPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="382"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Doctor list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" Padding="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="СПИСОК ВРАЧЕЙ"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Doctors}"
                             SelectedItem="{Binding SelectedDoctor, Mode=TwoWay}"
                             Background="{DynamicResource BgCardBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Height="510">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                            Background="{DynamicResource GhostHoverBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="👨‍⚕️" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Specialization}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,1"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Акт." FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Detail -->
            <StackPanel Grid.Column="1" Margin="52,0,0,0">
                <TextBlock Text="ФИО" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Padding="8,6" FontSize="13" Margin="0,0,0,10"
                         Text="{Binding SelectedDoctorFullName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="СПЕЦИАЛИЗАЦИЯ" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Padding="8,6" FontSize="13" Margin="0,0,0,10"
                         Text="{Binding SelectedDoctorSpecialization, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="СТАЖ (ЛЕТ)" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Padding="8,6" FontSize="13"
                                 Text="{Binding SelectedDoctorExperience, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2"
                              Content="Активен"
                              VerticalAlignment="Bottom"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsChecked="{Binding SelectedDoctorIsActive, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Text="УСЛУГИ ВРАЧА" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                <TextBlock Text="Отметьте услуги, которые ведёт данный врач" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10" Height="280">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableServices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Title}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              Width="170" Margin="4,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
