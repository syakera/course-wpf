<Window x:Class="MedicalCenter.Views.DoctorScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание врача"
        Width="960" Height="620"
        WindowStartupLocation="CenterOwner">
    <DockPanel Background="{DynamicResource BgDarkBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DoctorName}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Личный кабинет врача" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Дата:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="150"/>
                    <Button Content="Показать"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <Button Content="✔ Завершена"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding MarkCompletedCommand}" Margin="0,0,8,0"/>
                    <Button Content="● Неявка"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding MarkNoShowCommand}" Margin="0,0,8,0"/>
                    <Button Content="🖊 Добавить назначение"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding AddPrescriptionCommand}"/>
                </WrapPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="↶ Отменить"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding UndoCommand}" Margin="0,0,8,0"/>
                    <Button Content="↷ Повторить"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RedoCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Appointments}"
                  SelectedItem="{Binding SelectedAppointment, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource BgDarkBrush}"
                  RowBackground="{DynamicResource BgCardBrush}"
                  AlternatingRowBackground="{DynamicResource BgInputBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0"
                  Margin="20,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время"       Binding="{Binding Time}"        Width="80"/>
                <DataGridTextColumn Header="Пациент"     Binding="{Binding PatientName}" Width="240"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}"     Width="*"/>
                <DataGridTextColumn Header="Статус"      Binding="{Binding Status}"      Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
