<Window x:Class="MedicalCenter.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medical Center — Вход"
        Icon="/Assets/MedCenter.ico"
        Cursor="/Assets/arrow.cur"
        Width="544" Height="527"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BgCardBrush}">
        <Rectangle VerticalAlignment="Top" Height="6" Fill="{DynamicResource AccentBrush}"/>

        <Border Width="540"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Добро пожаловать"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Войдите в свой аккаунт"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,20"/>

                <TextBlock Text="Логин"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="UsernameBox"
                         FontSize="13"
                         Margin="0,0,0,18"/>

                <TextBlock Text="Пароль"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox"
                             FontSize="13"
                             Margin="0,0,0,8"/>

                <TextBlock Text="Для врача — пароль по умолчанию: doctor"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,18"/>

                <Border x:Name="ErrorBorder"
                        Background="#FFF4E8E8"
                        BorderBrush="#FFE36B6B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               Foreground="#FFB42323"
                               FontSize="14"/>
                </Border>

                <Button x:Name="LoginButton"
                        Content="Войти"
                        FontSize="13"
                        Margin="0,0,0,12" Width="292"/>

                <Grid Margin="0,8,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="2" Fill="{DynamicResource BorderBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="или"
                               Margin="12,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Rectangle Grid.Column="2" Height="2" Fill="{DynamicResource BorderBrush}"/>
                </Grid>

                <Button x:Name="RegisterButton"
                        Content="Зарегистрироваться как пациент"
                        FontSize="13"
                        Style="{StaticResource GhostButtonStyle}" Width="298"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
