<Window x:Class="MedicalCenter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МедЦентр"
        MinWidth="1000" MinHeight="640"
        Width="1280" Height="780"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{DynamicResource BgDarkBrush}">

        <!-- Top menu -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource BgPanelBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}">
            <MenuItem Header="Файл">
                <MenuItem Header="Профиль" Command="{Binding OpenProfileCommand}"/>
                <MenuItem Header="Мои записи" Command="{Binding OpenAppointmentsCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Таблицы БД" Command="{Binding OpenDbTablesCommand}"/>
                <Separator/>
                <MenuItem Header="Отменить" Command="{Binding UndoCommand}"/>
                <MenuItem Header="Повторить" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="Сбросить фильтры" Command="{Binding ClearFiltersCommand}"/>
            </MenuItem>
            <MenuItem Header="Язык">
                <MenuItem Header="Русский" Command="{Binding SwitchToRuCommand}"/>
                <MenuItem Header="English" Command="{Binding SwitchToEnCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Header with logo, search and quick actions -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="✚" FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="МедЦентр" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Забота о вашем здоровье" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="1" Margin="24,8"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="20">
                    <Grid>
                        <TextBlock Text="Поиск услуги или врача..."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="16,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox"
                                 Style="{x:Null}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="16,8"
                                 FontSize="14"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Right side: upcoming appointment + role badge + buttons -->
                <WrapPanel Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <!-- Upcoming appointment widget (patient only) -->
                    <Border Margin="0,0,12,0"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPatient}" Value="True"/>
                                            <Condition Binding="{Binding HasUpcomingAppointment}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="14" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding UpcomingAppointmentTitle}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding UpcomingAppointmentWhen}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Role badge -->
                    <Border CornerRadius="10" Padding="10,4" Margin="0,0,8,0"
                            Background="{DynamicResource GhostHoverBrush}">
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Администратор"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPatient}" Value="True">
                                            <Setter Property="Text" Value="Пациент"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Doctors (patient/admin both) -->
                    <Button Content="Врачи" Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding OpenDoctorsCommand}" Margin="0,0,6,0"/>

                    <!-- Doctor management (admin only) -->
                    <Button Content="Управление врачами"
                            Command="{Binding OpenDoctorManagementCommand}"
                            Margin="0,0,6,6"
                            Padding="12,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Appointments -->
                    <Button Content="Записи"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding OpenAppointmentsCommand}"
                            Margin="0,0,6,0"/>

                    <!-- DB tables (admin only) -->
                    <Button Content="Таблицы БД"
                            Command="{Binding OpenDbTablesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Sidebar + Content -->
        <Grid Background="{DynamicResource BgDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="220" MaxWidth="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left filters sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="КАТЕГОРИИ"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Categories}"
                                 DisplayMemberPath="Display"
                                 SelectedValuePath="Key"
                                 SelectedValue="{Binding SelectedCategory}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextSecondaryBrush}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource GhostHoverBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Text="ДИАПАЗОН ЦЕН"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BgCardBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,6"/>
                            <TextBlock Grid.Column="1" Text="–"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BgCardBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1" Padding="8,6"/>
                        </Grid>

                        <TextBlock Text="СОРТИРОВКА"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/>
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SortOption}"
                                  Background="{DynamicResource BgCardBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"/>

                        <Button Content="Сбросить фильтры"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,16,0,0"/>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="📋 "/>
                            <Run Text="{Binding ServicesCount, Mode=OneWay}"/>
                            <Run Text=" услуг"/>
                        </TextBlock>

                        <Button Content="+ Добавить услугу"
                                Command="{Binding AddCommand}"
                                Margin="0,16,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Service list (rows, per рис. 5.6) -->
            <Grid Grid.Column="1" Margin="20" Background="{DynamicResource BgDarkBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Background="{DynamicResource BgCardBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Marker dot -->
                                        <Border Grid.Column="0" Width="18" Height="18"
                                                Margin="0,4,12,0"
                                                CornerRadius="9"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="2"
                                                VerticalAlignment="Top"/>

                                        <!-- Main info -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource WarningBrush}"
                                                        CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="СКИДКА" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding ShortName}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="★" Foreground="{DynamicResource RatingStarBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}"
                                                           FontSize="11" Margin="2,0,12,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="🕐 " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding Duration}"/>
                                                    <Run Text="мин"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right side: price + actions -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="от " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                                                <TextBlock FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="{Binding FinalPrice, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                                    <Run Text="р."/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Patient -->
                                            <Button Content="Записаться"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsPatient, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Admin actions -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="✎"
                                                        Width="32" Height="28" Margin="0,0,6,0"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="🗑"
                                                        Width="32" Height="28"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServicesCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🏥" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Услуги не найдены"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
