<Window x:Class="MedicalCenter.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Icon="/Assets/MedCenter.ico"
        Cursor="/Assets/arrow.cur"
        Width="780" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource BgDarkBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: avatar + title -->
        <Border Grid.Column="0"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="90" Height="90" CornerRadius="45"
                        Background="{DynamicResource BgCardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,16">
                    <TextBlock Text="👤" FontSize="44"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Создать аккаунт"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Заполните данные для регистрации пациента"
                           FontSize="11"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right side: form -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: ЛОГИН / ФИО -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="ЛОГИН" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="UsernameBox" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="ФИО" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FullNameBox" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <!-- Row 1: ТЕЛЕФОН / EMAIL -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="ТЕЛЕФОН" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="PhoneBox" Padding="8,6" FontSize="13"
                                 ToolTip="+375(XX)XXX-XX-XX"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="EmailBox" Padding="8,6" FontSize="13"/>
                    </StackPanel>

                    <!-- Row 2: ПАРОЛЬ / ПОДТВЕРЖДЕНИЕ -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                        <TextBlock Text="ПАРОЛЬ" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordBox" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="ПОДТВЕРЖДЕНИЕ ПАРОЛЯ" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="1" x:Name="ErrorBorder"
                    Background="#FFE6E6" BorderBrush="#E74C3C"
                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorTextBlock" Foreground="#E74C3C" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="Отмена"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True" Margin="0,0,10,0"/>
                <Button x:Name="RegisterButton" Content="Зарегистрироваться"
                        Style="{StaticResource BaseButtonStyle}"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
